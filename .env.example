# =============================================================================
# LOOK — environment template
# Copy to .env.local for local development. Set the same keys in Vercel for production.
# Never commit real secrets.
# =============================================================================

# --- Supabase ---
# Leave empty for demo/mock mode locally.
NEXT_PUBLIC_SUPABASE_URL=
# Prefer publishable key (sb_publishable_…, ~40–60 chars) from API Keys.
# Legacy JWT anon (eyJ…, ~200 chars) also works until deactivated.
# Do NOT paste oversized/concatenated values — that causes "Invalid API key".
# Optional alias: NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (webhooks, admin scripts, seed). Required for Stripe webhook → DB.
# Prefer secret key (sb_secret_…) or legacy service_role JWT.
# Optional alias: SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Preview: after changing any NEXT_PUBLIC_* value, Redeploy the Preview
# (build-time inlining). Production env must stay on the production Supabase project.

# Database URI — for npm run supabase:apply-pending / supabase:seed-test-users
# Project Settings → Database → Connection string (URI)
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Optional: Supabase Management API (auth URL config, migration apply via API)
# SUPABASE_ACCESS_TOKEN=

# --- App URL ---
# Development (browser):
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# Desktop Electron shell sets http://127.0.0.1:3010 automatically — do not put that in Vercel.
# Production (Vercel / lookcruise.com) — REQUIRED for public site:
# NEXT_PUBLIC_APP_URL=https://lookcruise.com

# Force demo/mock mode (optional)
# NEXT_PUBLIC_USE_MOCK_DATA=true

# --- Test login (development only; always disabled when NODE_ENV=production) ---
# NEXT_PUBLIC_ENABLE_TEST_LOGIN=true
# NEXT_PUBLIC_TEST_CUSTOMER_EMAIL=customer@test.look
# NEXT_PUBLIC_TEST_CUSTOMER_PASSWORD=Test1234!
# NEXT_PUBLIC_TEST_PROVIDER_EMAIL=provider@test.look
# NEXT_PUBLIC_TEST_PROVIDER_PASSWORD=Test1234!

# --- Finance ---
# Platform commission (0.10 = 10%). DB platform_settings may also store this.
# NEXT_PUBLIC_PLATFORM_COMMISSION_RATE=0.10

# Simulated/test payments & payouts (server-only). No real Stripe charges.
# Production (VERCEL_ENV=production, or local NODE_ENV=production without Vercel) hard-denies.
# Vercel Preview: set ENABLE_TEST_PAYMENTS=true for Preview only (+ LOOK Staging keys).
# Local/dev: set true to show "Test payment" for @test.look accounts and admins.
ENABLE_TEST_PAYMENTS=false

# --- Stripe (add when ready; do not invent values) ---
# Dashboard test keys: https://dashboard.stripe.com/test/apikeys
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Webhook signing secret for POST /api/webhooks/stripe
# Local: stripe listen --forward-to localhost:3000/api/webhooks/stripe
# Production: Stripe Dashboard → Webhooks → https://lookcruise.com/api/webhooks/stripe
# STRIPE_WEBHOOK_SECRET=whsec_...

# --- Deploy helpers ---
# npm run deploy / deploy:domain
# npm run deploy:supabase-auth
# npm run deploy:dns
# npm run preflight:production
